  {
    "description": "Location-independent identifier (id)",
    "compatibility": "3,<=4",
    "schema": {
      "properties": {
        "foo": {
          "$ref": "#foo"
        }
      },
      "definitions": {
        "A": {
          "id": "#foo",
          "type": "integer"
        }
      }
    },
    "tests": [
      {
        "data": {
          "foo": 1
        },
        "description": "match",
        "valid": true
      }
    ]
  },
  {
    "description": "Location-independent identifier with base URI change in subschema (id)",
    "compatibility": "3,<=4",
    "schema": {
      "id": "http://localhost:1234/root",
      "properties": {
        "foo": {
          "$ref": "http://localhost:1234/nested.json#foo"
        }
      },
      "definitions": {
        "A": {
          "id": "nested.json",
          "definitions": {
            "B": {
              "id": "#foo",
              "type": "integer"
            }
          }
        }
      }
    },
    "tests": [
      {
        "data": {
          "foo": 1
        },
        "description": "match",
        "valid": true
      }
    ]
  },
