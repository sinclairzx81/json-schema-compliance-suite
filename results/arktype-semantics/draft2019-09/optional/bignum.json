        "data": 9.824928374923492e+52,
        "valid": true
      },
      {
        "description": "a negative bignum is a number",
        "data": -9.824928374923492e+52,
        "valid": true
      }
    ]
  },
  {
    "description": "string",
    "schema": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
