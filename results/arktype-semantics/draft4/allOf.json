[
  {
    "description": "nested allOf, to check validation semantics",
    "schema": {
      "allOf": [
        {
          "allOf": [
            {
              "type": "null"
            }
          ]
        }
      ]
    },
    "tests": [
      {
        "description": "null is valid",
        "data": null,
        "valid": true
      },
      {
        "description": "anything non-null is invalid",
        "data": 123,
        "valid": false
      }
    ]
  }
]