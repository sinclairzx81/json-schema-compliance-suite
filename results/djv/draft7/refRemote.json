        "data": {
          "list": [
            1
          ]
        },
        "valid": true
      },
      {
        "description": "string is invalid",
        "data": {
          "list": [
            "a"
          ]
        },
        "valid": false
      }
    ]
  },
  {
    "description": "Location-independent identifier in remote ref",
    "schema": {
      "$ref": "http://localhost:1234/draft7/locationIndependentIdentifier.json#/definitions/refToInteger"
