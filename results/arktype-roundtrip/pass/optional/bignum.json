[
  {
    "description": "integer",
    "schema": {
      "type": "integer"
    },
    "tests": [
      {
        "description": "a bignum is an integer",
        "data": 1.2345678910111214e+52,
        "valid": true
      },
      {
        "description": "a negative bignum is an integer",
        "data": -1.2345678910111214e+52,
        "valid": true
      }
    ]
  },
  {
    "description": "number",
    "schema": {
      "type": "number"
    },
    "tests": [
      {
        "description": "a bignum is a number",
        "data": 9.824928374923492e+52,
        "valid": true
      },
      {
        "description": "a negative bignum is a number",
        "data": -9.824928374923492e+52,
        "valid": true
      }
    ]
  },
  {
    "description": "string",
    "schema": {
      "type": "string"
    },
    "tests": [
      {
        "description": "a bignum is not a string",
        "data": 9.824928374923492e+52,
        "valid": false
      }
    ]
  },
  {
    "description": "enum comparison with high precision",
    "schema": {
      "enum": [
        0.12345678912345678
      ]
    },
    "tests": [
      {
        "description": "the exact decimal is valid",
        "data": 0.12345678912345678,
        "valid": true
      }
    ]
  },
  {
    "description": "const comparison with high precision",
    "compatibility": "6",
    "schema": {
      "const": 0.12345678912345678
    },
    "tests": [
      {
        "description": "the exact decimal is valid",
        "data": 0.12345678912345678,
        "valid": true
      }
    ]
  }
]