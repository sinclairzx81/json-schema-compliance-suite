[
  {
    "description": "items and subitems",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "$defs": {
        "item": {
          "type": "array",
          "items": false,
          "prefixItems": [
            {
              "$ref": "#/$defs/sub-item"
            },
            {
              "$ref": "#/$defs/sub-item"
            }
          ]
        },
        "sub-item": {
          "type": "object",
          "required": [
            "foo"
          ]
        }
      },
      "type": "array",
      "items": false,
      "prefixItems": [
        {
          "$ref": "#/$defs/item"
        },
        {
          "$ref": "#/$defs/item"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "tests": [
      {
        "description": "valid items",
        "data": [
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      },
      {
        "description": "fewer items is valid",
        "data": [
          [
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "prefixItems with no additional items allowed",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "prefixItems": [
        {},
        {},
        {}
      ],
      "items": false
    },
    "tests": [
      {
        "description": "fewer number of items present (1)",
        "data": [
          1
        ],
        "valid": true
      },
      {
        "description": "fewer number of items present (2)",
        "data": [
          1,
          2
        ],
        "valid": true
      },
      {
        "description": "equal number of items present",
        "data": [
          1,
          2,
          3
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "prefixItems validation adjusts the starting index for items",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "prefixItems": [
        {
          "type": "string"
        }
      ],
      "items": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "valid items",
        "data": [
          "x",
          2,
          3
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "items with heterogeneous array",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "prefixItems": [
        {}
      ],
      "items": false
    },
    "tests": [
      {
        "description": "valid instance",
        "data": [
          null
        ],
        "valid": true
      }
    ]
  }
]