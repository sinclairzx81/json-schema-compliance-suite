[
  {
    "description": "uri-template format annotation",
    "compatibility": "6",
    "tags": [
      "format-annotation"
    ],
    "schema": {
      "format": "uri-template"
    },
    "tests": [
      {
        "description": "invalid uri-template string is only an annotation by default",
        "data": "http://example.com/dictionary/{term:1}/{term",
        "valid": true
      }
    ]
  },
  {
    "description": "validation of URI-Templates",
    "compatibility": "6",
    "tags": [
      "format-assertion"
    ],
    "schema": {
      "format": "uri-template"
    },
    "tests": [
      {
        "description": "a dotted variable name is valid",
        "data": "{a.b}",
        "valid": true
      },
      {
        "description": "a delete character in a literal is invalid",
        "data": "ab",
        "valid": false
      },
      {
        "description": "an apostrophe in a literal is valid",
        "data": "a'b",
        "valid": true
      }
    ]
  }
]