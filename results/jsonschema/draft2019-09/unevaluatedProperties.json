  {
    "description": "unevaluatedProperties with anyOf",
    "schema": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "type": "object",
      "properties": {
        "foo": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "properties": {
            "bar": {
              "const": "bar"
            }
          },
          "required": [
            "bar"
          ]
        },
        {
          "properties": {
            "baz": {
              "const": "baz"
            }
          },
          "required": [
            "baz"
          ]
        },
        {
          "properties": {
            "quux": {
              "const": "quux"
            }
          },
          "required": [
            "quux"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "tests": [
      {
        "description": "when one matches and has no unevaluated properties",
        "data": {
          "foo": "foo",
          "bar": "bar"
        },
        "valid": true
      },
      {
        "description": "when two match and has no unevaluated properties",
        "data": {
          "foo": "foo",
          "bar": "bar",
          "baz": "baz"
        },
        "valid": true
      }
    ]
  },
  {
    "description": "unevaluatedProperties with oneOf",
