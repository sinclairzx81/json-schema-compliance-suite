          "unevaluatedProperties": false
        }
      ],
      "anyOf": [
        {
          "properties": {
            "bar": true
          }
        }
      ]
    },
    "tests": [
      {
        "description": "in place applicator siblings, bar is missing",
        "data": {
          "foo": 1
        },
        "valid": true
      }
    ]
  },
  {
    "description": "in-place applicator siblings, anyOf has unevaluated",
