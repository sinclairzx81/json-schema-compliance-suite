            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "tests": [
      {
        "description": "with only the nested evaluated property",
        "data": {
          "foo": {
            "bar": "foo"
          }
        },
        "valid": true
      }
    ]
  },
