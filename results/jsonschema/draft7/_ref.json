        "description": "a non-string is invalid",
        "data": {
          "foo": 12
        },
        "valid": false
      }
    ]
  },
  {
    "description": "ref to if",
    "schema": {
      "allOf": [
        {
          "$ref": "http://example.com/ref/if"
        },
        {
          "if": {
            "$id": "http://example.com/ref/if",
            "type": "integer"
          }
        }
      ]
    },
    "tests": [
      {
        "description": "a non-integer is invalid due to the $ref",
        "data": "foo",
        "valid": false
      },
      {
        "description": "an integer is valid",
        "data": 12,
        "valid": true
      }
    ]
  },
