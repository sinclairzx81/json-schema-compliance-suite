  {
    "description": "$ref to $dynamicRef finds detached $dynamicAnchor",
    "compatibility": "9999",
    "schema": {
      "$ref": "http://localhost:1234/detached-dynamicref.json#/$defs/foo"
    },
    "externalSchemas": {
      "http://localhost:1234/detached-dynamicref.json": {
        "$defs": {
          "foo": {
            "$dynamicRef": "detached"
          },
          "detached": {
            "$dynamicAnchor": "detached",
            "type": "integer"
          }
        }
      }
    },
    "tests": [
      {
        "description": "number is valid",
        "data": 1,
        "valid": true
      }
    ]
  },
