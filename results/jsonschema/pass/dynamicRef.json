[
  {
    "description": "A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor",
    "compatibility": "9999",
    "schema": {
      "type": "array",
      "items": {
        "$dynamicRef": "items"
      },
      "$defs": {
        "foo": {
          "$dynamicAnchor": "items",
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "An array of strings is valid",
        "data": [
          "foo",
          "bar"
        ],
        "valid": true
      }
    ]
  },
