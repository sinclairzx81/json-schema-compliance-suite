  {
    "description": "$dynamicRef points to a boolean schema",
    "compatibility": "=2020",
    "schema": {
      "$defs": {
        "true": true,
        "false": false
      },
      "properties": {
        "true": {
          "$dynamicRef": "#/$defs/true"
        },
        "false": {
          "$dynamicRef": "#/$defs/false"
        }
      }
    },
    "tests": [
      {
        "description": "follow $dynamicRef to a true schema",
        "data": {
          "true": 1
        },
        "valid": true
      }
    ]
  }
