  {
    "description": "tests for implementation dynamic anchor and reference link",
    "compatibility": "9999",
    "schema": {
      "$id": "http://localhost:1234/strict-extendible.json",
      "$ref": "extendible-dynamic-ref.json",
      "$defs": {
        "elements": {
          "$dynamicAnchor": "elements",
          "properties": {
            "a": true
          },
          "required": [
            "a"
          ],
          "additionalProperties": false
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/extendible-dynamic-ref.json": {
        "description": "extendible array",
        "type": "object",
        "properties": {
          "elements": {
            "type": "array",
            "items": {
              "$dynamicRef": "elements"
            }
          }
        },
        "required": [
          "elements"
        ],
        "additionalProperties": false,
        "$defs": {
          "elements": {
            "$dynamicAnchor": "elements"
          }
        }
      }
    },
    "tests": [
      {
        "description": "incorrect parent schema",
        "data": {
          "a": true
        },
        "valid": false
      },
      {
        "description": "correct extended schema",
        "data": {
          "elements": [
            {
              "a": 1
            }
          ]
        },
        "valid": true
      }
    ]
  },
