[
  {
    "description": "A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor",
    "compatibility": "9999",
    "schema": {
      "type": "array",
      "items": {
        "$dynamicRef": "items"
      },
      "$defs": {
        "foo": {
          "$dynamicAnchor": "items",
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "An array of strings is valid",
        "data": [
          "foo",
          "bar"
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor (2020)",
    "compatibility": "=2020",
    "schema": {
      "type": "array",
      "items": {
        "$dynamicRef": "#items"
      },
      "$defs": {
        "foo": {
          "$dynamicAnchor": "items",
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "An array of strings is valid",
        "data": [
          "foo",
          "bar"
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "A $dynamicRef to an $anchor in the same schema resource behaves like a normal $ref to an $anchor",
    "compatibility": "=2020",
    "schema": {
      "type": "array",
      "items": {
        "$dynamicRef": "#items"
      },
      "$defs": {
        "foo": {
          "$anchor": "items",
          "type": "string"
        }
      }
    },
    "tests": [
      {
        "description": "An array of strings is valid",
        "data": [
          "foo",
          "bar"
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "$dynamicRef points to a boolean schema",
    "compatibility": "=2020",
    "schema": {
      "$defs": {
        "true": true,
        "false": false
      },
      "properties": {
        "true": {
          "$dynamicRef": "#/$defs/true"
        },
        "false": {
          "$dynamicRef": "#/$defs/false"
        }
      }
    },
    "tests": [
      {
        "description": "follow $dynamicRef to a true schema",
        "data": {
          "true": 1
        },
        "valid": true
      }
    ]
  }
]