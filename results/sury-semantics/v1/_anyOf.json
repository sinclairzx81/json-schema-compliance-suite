[
  {
    "description": "anyOf",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "minimum": 2
        }
      ]
    },
    "tests": [
      {
        "description": "neither anyOf valid",
        "data": 1.5,
        "valid": false
      }
    ]
  },
  {
    "description": "anyOf with base schema",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "type": "string",
      "anyOf": [
        {
          "maxLength": 2
        },
        {
          "minLength": 4
        }
      ]
    },
    "tests": [
      {
        "description": "mismatch base schema",
        "data": 3,
        "valid": false
      },
      {
        "description": "both anyOf invalid",
        "data": "foo",
        "valid": false
      }
    ]
  },
  {
    "description": "anyOf complex types",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "anyOf": [
        {
          "properties": {
            "bar": {
              "type": "integer"
            }
          },
          "required": [
            "bar"
          ]
        },
        {
          "properties": {
            "foo": {
              "type": "string"
            }
          },
          "required": [
            "foo"
          ]
        }
      ]
    },
    "tests": [
      {
        "description": "neither anyOf valid (complex)",
        "data": {
          "foo": 2,
          "bar": "quux"
        },
        "valid": false
      }
    ]
  }
]