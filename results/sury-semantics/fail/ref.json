[
  {
    "description": "ref applies alongside sibling keywords",
    "compatibility": "2019",
    "schema": {
      "$defs": {
        "reffed": {
          "type": "array"
        }
      },
      "properties": {
        "foo": {
          "$ref": "#/$defs/reffed",
          "maxItems": 2
        }
      }
    },
    "tests": [
      {
        "description": "ref valid, maxItems invalid",
        "data": {
          "foo": [
            1,
            2,
            3
          ]
        },
        "valid": false
      }
    ]
  },
  {
    "description": "Recursive references between schemas",
    "compatibility": "3",
    "schema": {
      "$ref": "http://localhost:1234/tree"
    },
    "externalSchemas": {
      "http://localhost:1234/tree": {
        "description": "tree of nodes",
        "type": "object",
        "properties": {
          "meta": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "node"
            }
          }
        }
      },
      "http://localhost:1234/node": {
        "description": "node",
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "subtree": {
            "$ref": "tree"
          }
        }
      }
    },
    "tests": [
      {
        "description": "valid tree",
        "data": {
          "meta": "root",
          "nodes": [
            {
              "value": 1,
              "subtree": {
                "meta": "child",
                "nodes": [
                  {
                    "value": 1.1
                  },
                  {
                    "value": 1.2
                  }
                ]
              }
            },
            {
              "value": 2,
              "subtree": {
                "meta": "child",
                "nodes": [
                  {
                    "value": 2.1
                  },
                  {
                    "value": 2.2
                  }
                ]
              }
            }
          ]
        },
        "valid": true
      },
      {
        "description": "invalid tree",
        "data": {
          "meta": "root",
          "nodes": [
            {
              "value": 1,
              "subtree": {
                "meta": "child",
                "nodes": [
                  {
                    "value": "string is invalid"
                  },
                  {
                    "value": 1.2
                  }
                ]
              }
            },
            {
              "value": 2,
              "subtree": {
                "meta": "child",
                "nodes": [
                  {
                    "value": 2.1
                  },
                  {
                    "value": 2.2
                  }
                ]
              }
            }
          ]
        },
        "valid": false
      }
    ]
  },
  {
    "description": "ref creates new scope when adjacent to keywords",
    "compatibility": "2019",
    "schema": {
      "$defs": {
        "A": {
          "unevaluatedProperties": false
        }
      },
      "properties": {
        "prop1": {
          "type": "string"
        }
      },
      "$ref": "#/$defs/A"
    },
    "tests": [
      {
        "description": "referenced subschema doesn't see annotations from properties",
        "data": {
          "prop1": "match"
        },
        "valid": false
      }
    ]
  },
  {
    "description": "remote ref",
    "schema": {
      "$ref": "http://localhost:1234/integer.json"
    },
    "compatibility": "3",
    "externalSchemas": {
      "http://localhost:1234/integer.json": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "remote ref valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "remote ref invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "fragment within remote ref",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/subSchemas.json#/$defs/integer"
    },
    "externalSchemas": {
      "http://localhost:1234/subSchemas.json": {
        "$defs": {
          "integer": {
            "type": "integer"
          }
        }
      }
    },
    "tests": [
      {
        "description": "remote fragment valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "remote fragment invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "ref within remote ref",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/subSchemas.json#/$defs/refToInteger"
    },
    "externalSchemas": {
      "http://localhost:1234/subSchemas.json": {
        "$defs": {
          "integer": {
            "type": "integer"
          },
          "refToInteger": {
            "$ref": "#/$defs/integer"
          }
        }
      }
    },
    "tests": [
      {
        "description": "ref within ref valid",
        "data": 1,
        "valid": true
      },
      {
        "description": "ref within ref invalid",
        "data": "a",
        "valid": false
      }
    ]
  },
  {
    "description": "root ref in remote ref",
    "compatibility": "2019",
    "schema": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "http://localhost:1234/name-defs.json#/$defs/orNull"
        }
      }
    },
    "externalSchemas": {
      "http://localhost:1234/name-defs.json": {
        "$defs": {
          "orNull": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#"
              }
            ]
          }
        },
        "type": "string"
      }
    },
    "tests": [
      {
        "description": "string is valid",
        "data": {
          "name": "foo"
        },
        "valid": true
      },
      {
        "description": "null is valid",
        "data": {
          "name": null
        },
        "valid": true
      },
      {
        "description": "object is invalid",
        "data": {
          "name": {
            "name": null
          }
        },
        "valid": false
      }
    ]
  },
  {
    "description": "remote ref with ref to defs",
    "compatibility": "2019",
    "schema": {
      "$ref": "http://localhost:1234/ref-and-defs.json"
    },
    "externalSchemas": {
      "http://localhost:1234/ref-and-defs.json": {
        "$defs": {
          "inner": {
            "properties": {
              "bar": {
                "type": "string"
              }
            }
          }
        },
        "$ref": "#/$defs/inner"
      }
    },
    "tests": [
      {
        "description": "invalid",
        "data": {
          "bar": 1
        },
        "valid": false
      },
      {
        "description": "valid",
        "data": {
          "bar": "a"
        },
        "valid": true
      }
    ]
  }
]