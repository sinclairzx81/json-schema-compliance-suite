    "schema": {
      "$schema": "https://json-schema.org/draft/2019-09/schema",
      "allOf": [
        false,
        false
      ]
    },
    "tests": [
      {
        "description": "any value is invalid",
        "data": "foo",
        "valid": false
      }
    ]
  }
