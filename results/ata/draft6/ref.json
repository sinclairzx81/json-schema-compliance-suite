    "schema": {
      "$comment": "RFC 8141 §2.3.2",
      "$id": "urn:example:weather?=op=map&lat=39.56&lon=-104.85&datetime=1969-07-21T02:56:15Z",
      "properties": {
        "foo": {
          "$ref": "#/definitions/bar"
        }
