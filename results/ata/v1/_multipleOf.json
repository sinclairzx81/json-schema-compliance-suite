[
  {
    "description": "by small number",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "multipleOf": 0.0001
    },
    "tests": [
      {
        "description": "0.0075 is multiple of 0.0001",
        "data": 0.0075,
        "valid": true
      }
    ]
  },
  {
    "description": "small multiple of large integer",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "type": "integer",
      "multipleOf": 1e-8
    },
    "tests": [
      {
        "description": "any integer is a multiple of 1e-8",
        "data": 12391239123,
        "valid": true
      }
    ]
  }
]