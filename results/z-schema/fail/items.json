[
  {
    "description": "an array of schemas for items",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "tests": [
      {
        "description": "correct types",
        "data": [
          1,
          "foo"
        ],
        "valid": true
      },
      {
        "description": "incomplete array of items",
        "data": [
          1
        ],
        "valid": true
      },
      {
        "description": "array with additional items",
        "data": [
          1,
          "foo",
          true
        ],
        "valid": true
      },
      {
        "description": "empty array",
        "data": [],
        "valid": true
      },
      {
        "description": "JavaScript pseudo-array is valid",
        "data": {
          "0": "invalid",
          "1": "valid",
          "length": 2
        },
        "valid": true
      }
    ]
  },
  {
    "description": "items as array with boolean schemas",
    "compatibility": "6,<=2019",
    "schema": {
      "items": [
        true,
        false
      ]
    },
    "tests": [
      {
        "description": "array with one item is valid",
        "data": [
          1
        ],
        "valid": true
      },
      {
        "description": "empty array is valid",
        "data": [],
        "valid": true
      }
    ]
  },
  {
    "description": "items and subitems (2019)",
    "compatibility": "=2019",
    "schema": {
      "$defs": {
        "item": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "$ref": "#/$defs/sub-item"
            },
            {
              "$ref": "#/$defs/sub-item"
            }
          ]
        },
        "sub-item": {
          "type": "object",
          "required": [
            "foo"
          ]
        }
      },
      "type": "array",
      "additionalItems": false,
      "items": [
        {
          "$ref": "#/$defs/item"
        },
        {
          "$ref": "#/$defs/item"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "tests": [
      {
        "description": "valid items",
        "data": [
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      },
      {
        "description": "fewer items is valid",
        "data": [
          [
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "items and subitems (7)",
    "compatibility": "<=7",
    "schema": {
      "definitions": {
        "item": {
          "type": "array",
          "additionalItems": false,
          "items": [
            {
              "$ref": "#/definitions/sub-item"
            },
            {
              "$ref": "#/definitions/sub-item"
            }
          ]
        },
        "sub-item": {
          "type": "object",
          "properties": {
            "foo": {
              "type": "null"
            }
          }
        }
      },
      "type": "array",
      "additionalItems": false,
      "items": [
        {
          "$ref": "#/definitions/item"
        },
        {
          "$ref": "#/definitions/item"
        },
        {
          "$ref": "#/definitions/item"
        }
      ]
    },
    "tests": [
      {
        "description": "valid items",
        "data": [
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            },
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      },
      {
        "description": "fewer items is valid",
        "data": [
          [
            {
              "foo": null
            }
          ],
          [
            {
              "foo": null
            }
          ]
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "array-form items with null instance elements",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {
          "type": "null"
        }
      ]
    },
    "tests": [
      {
        "description": "allows null elements",
        "data": [
          null
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "array of items with no additional items permitted",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {},
        {},
        {}
      ],
      "additionalItems": false
    },
    "tests": [
      {
        "description": "empty array",
        "data": [],
        "valid": true
      },
      {
        "description": "fewer number of items present (1)",
        "data": [
          1
        ],
        "valid": true
      },
      {
        "description": "fewer number of items present (2)",
        "data": [
          1,
          2
        ],
        "valid": true
      },
      {
        "description": "equal number of items present",
        "data": [
          1,
          2,
          3
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "additional items are allowed by default (2019)",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {
          "type": "integer"
        }
      ]
    },
    "tests": [
      {
        "description": "only the first item is validated",
        "data": [
          1,
          "foo",
          false
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "items validation adjusts the starting index for additionalItems",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {
          "type": "string"
        }
      ],
      "additionalItems": {
        "type": "integer"
      }
    },
    "tests": [
      {
        "description": "valid items",
        "data": [
          "x",
          2,
          3
        ],
        "valid": true
      }
    ]
  },
  {
    "description": "additionalItems with heterogeneous array",
    "compatibility": "<=2019",
    "schema": {
      "items": [
        {}
      ],
      "additionalItems": false
    },
    "tests": [
      {
        "description": "valid instance",
        "data": [
          null
        ],
        "valid": true
      }
    ]
  }
]