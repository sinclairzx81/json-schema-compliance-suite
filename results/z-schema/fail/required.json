[
  {
    "description": "required validation (boolean)",
    "compatibility": "=3",
    "schema": {
      "properties": {
        "foo": {
          "required": true
        },
        "bar": {}
      }
    },
    "tests": [
      {
        "description": "present required property is valid",
        "data": {
          "foo": 1
        },
        "valid": true
      }
    ]
  },
  {
    "description": "required explicitly false validation",
    "compatibility": "=3",
    "schema": {
      "properties": {
        "foo": {
          "required": false
        }
      }
    },
    "tests": [
      {
        "description": "not required if required is false",
        "data": {},
        "valid": true
      }
    ]
  }
]