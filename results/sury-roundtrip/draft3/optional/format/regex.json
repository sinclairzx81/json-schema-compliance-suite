[
  {
    "description": "validation of regular expressions",
    "schema": {
      "format": "regex"
    },
    "tests": [
      {
        "description": "a valid regular expression",
        "data": "([abc])+\\s+$",
        "valid": true
      },
      {
        "description": "an empty regular expression is valid",
        "data": "",
        "valid": true
      },
      {
        "description": "alternation is valid",
        "data": "a|b",
        "valid": true
      },
      {
        "description": "a bounded quantifier is valid",
        "data": "a{2,3}",
        "valid": true
      },
      {
        "description": "a negated range character class is valid",
        "data": "[^a-z]",
        "valid": true
      },
      {
        "description": "a lazy quantifier is valid",
        "data": "a+?",
        "valid": true
      }
    ]
  }
]