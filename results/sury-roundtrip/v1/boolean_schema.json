      },
      {
        "description": "empty object is valid",
        "data": {},
        "valid": true
      },
      {
        "description": "array is valid",
        "data": [
          "foo"
        ],
        "valid": true
      },
      {
        "description": "empty array is valid",
        "data": [],
        "valid": true
      }
    ]
  }
