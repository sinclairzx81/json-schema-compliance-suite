[
  {
    "description": "item is evaluated in an uncle schema to unevaluatedItems",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "foo": {
          "prefixItems": [
            {
              "type": "string"
            }
          ],
          "unevaluatedItems": false
        }
      },
      "anyOf": [
        {
          "properties": {
            "foo": {
              "prefixItems": [
                true,
                {
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    "tests": [
      {
        "description": "no extra items",
        "data": {
          "foo": [
            "test"
          ]
        },
        "valid": true
      }
    ]
  }
]