[
  {
    "description": "minContains=1 with contains",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "minContains": 1
    },
    "tests": [
      {
        "description": "empty data",
        "data": [],
        "valid": false
      },
      {
        "description": "no elements match",
        "data": [
          2
        ],
        "valid": false
      }
    ]
  },
  {
    "description": "minContains=2 with contains",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "minContains": 2
    },
    "tests": [
      {
        "description": "empty data",
        "data": [],
        "valid": false
      },
      {
        "description": "all elements match, invalid minContains",
        "data": [
          1
        ],
        "valid": false
      },
      {
        "description": "some elements match, invalid minContains",
        "data": [
          1,
          2
        ],
        "valid": false
      }
    ]
  },
  {
    "description": "minContains=2 with contains with a decimal value",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "minContains": 2
    },
    "tests": [
      {
        "description": "one element matches, invalid minContains",
        "data": [
          1
        ],
        "valid": false
      }
    ]
  },
  {
    "description": "maxContains = minContains",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "maxContains": 2,
      "minContains": 2
    },
    "tests": [
      {
        "description": "empty data",
        "data": [],
        "valid": false
      },
      {
        "description": "all elements match, invalid minContains",
        "data": [
          1
        ],
        "valid": false
      },
      {
        "description": "all elements match, invalid maxContains",
        "data": [
          1,
          1,
          1
        ],
        "valid": false
      }
    ]
  },
  {
    "description": "maxContains < minContains",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "maxContains": 1,
      "minContains": 3
    },
    "tests": [
      {
        "description": "empty data",
        "data": [],
        "valid": false
      },
      {
        "description": "invalid minContains",
        "data": [
          1
        ],
        "valid": false
      },
      {
        "description": "invalid maxContains",
        "data": [
          1,
          1,
          1
        ],
        "valid": false
      },
      {
        "description": "invalid maxContains and minContains",
        "data": [
          1,
          1
        ],
        "valid": false
      }
    ]
  },
  {
    "description": "minContains = 0 with maxContains",
    "schema": {
      "$schema": "https://json-schema.org/v1",
      "contains": {
        "const": 1
      },
      "minContains": 0,
      "maxContains": 1
    },
    "tests": [
      {
        "description": "too many",
        "data": [
          1,
          1
        ],
        "valid": false
      }
    ]
  }
]