{
  "name": "JSON Schema compliance suite",
  "description": "JSON Schema compliance suite for JavaScript validation libraries",
  "type": "module",
  "scripts": {
    "upgrade": "npm install -D $(node -p \"Object.keys(require('./package.json').devDependencies).map(p=>p+'@latest').join(' ')\")",
    "clean": "rm -rf results && rm -rf clone",
    "test": "node tests.ts"
  },
  "devDependencies": {
    "@ark/json-schema": "^0.0.7",
    "@cfworker/json-schema": "^4.1.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.2.3",
    "ata-validator": "^1.6.1",
    "djv": "^2.1.4",
    "jsonschema": "^1.5.0",
    "sury": "^11.0.0-rc.1",
    "typebox": "^1.3.12",
    "z-schema": "^12.4.1",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "ata-validator": true
  }
}
