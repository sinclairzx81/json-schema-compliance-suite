{
  "name": "JSON Schema compliance suite",
  "description": "JSON Schema compliance suite for JavaScript validation libraries",
  "type": "module",
  "scripts": {
    "upgrade": "npm install -D -E $(node -p \"Object.keys(require('./package.json').devDependencies).map(p=>p+'@latest').join(' ')\")",
    "clean": "rm -rf results && rm -rf clone",
    "test": "node tests.ts"
  },
  "devDependencies": {
    "@ark/json-schema": "0.0.12",
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "arktype": "2.2.8",
    "ata-validator": "1.48.0",
    "djv": "2.1.4",
    "jsonschema": "1.5.0",
    "sury": "11.1.0-rc.0",
    "typebox": "1.3.36",
    "z-schema": "12.5.0",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "ata-validator": true
  },
  "dependencies": {
    "@corvus-dotnet/json-schema": "^0.1.0"
  }
}
